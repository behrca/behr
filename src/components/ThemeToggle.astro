---
// ThemeToggle.astro: round sun/moon button that switches light and dark mode.
// The choice is saved in the browser. The button is a small piece of "liquid glass": it squishes
// like a droplet when pressed, and the new colors spread out from it with a soft, feathered edge.
---

<button
	type="button"
	class="theme-toggle"
	id="theme-toggle"
	aria-label="Switch to light mode"
	title="Switch between light and dark mode"
>
	<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
		<defs>
			<mask id="theme-moon-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
				<rect width="24" height="24" fill="#fff"></rect>
				<circle class="cut" cx="12" cy="12" r="6.5" fill="#000"></circle>
			</mask>
		</defs>
		<circle class="core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-moon-mask)"></circle>
		<g class="rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<line x1="12" y1="2" x2="12" y2="4"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(45 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(90 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(135 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(180 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(225 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(270 12 12)"></line>
			<line x1="12" y1="2" x2="12" y2="4" transform="rotate(315 12 12)"></line>
		</g>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const deviceDark = window.matchMedia('(prefers-color-scheme: dark)');

	const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');

	function apply(theme: 'light' | 'dark') {
		root.dataset.theme = theme;
		btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
	}
		// Normally the script in <head> has already set the theme. If it didn't, work it out here.
	if (!root.dataset.theme) {
		let saved: string | null = null;
		try {
			saved = localStorage.getItem('theme');
		} catch {}
		root.dataset.theme = saved === 'light' || saved === 'dark' ? saved : deviceDark.matches ? 'dark' : 'light';
	}
	apply(current());

	btn.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark';

		// a quick liquid squish, like pressing a droplet of glass
		if (!reduceMotion) {
			btn.animate(
				[
					{ transform: 'scale(1, 1)' },
					{ transform: 'scale(0.86, 0.9)', offset: 0.25 },
					{ transform: 'scale(1.08, 1.04)', offset: 0.55 },
					{ transform: 'scale(0.98, 1)', offset: 0.8 },
					{ transform: 'scale(1, 1)' },
				],
				{ duration: 620, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
			);
		}
		try {
			localStorage.setItem('theme', next);
		} catch {}

		const doc = document as any;

		// Browsers that can't do the soft reveal (or visitors who prefer less motion): a gentle fade
		if (!doc.startViewTransition || reduceMotion || !CSS.supports('mask-image', 'radial-gradient(#000, #000)') || !('registerProperty' in CSS)) {
			if (!reduceMotion) {
				root.classList.add('theme-fade');
				window.setTimeout(() => root.classList.remove('theme-fade'), 500);
			}
			apply(next);
			return;
		}

		// The new colors spread out from the button with a soft, feathered edge
		// (like light moving through glass rather than a hard-edged circle)
		const box = btn.getBoundingClientRect();
		const x = box.left + box.width / 2;
		const y = box.top + box.height / 2;
		const FEATHER = 140; // width of the soft edge, in pixels
		const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)) + FEATHER;
		root.style.setProperty('--tt-x', `${x}px`);
		root.style.setProperty('--tt-y', `${y}px`);
		root.style.setProperty('--tt-feather', `${FEATHER}px`);

		root.classList.add('theme-switching'); // switches on the theme-only transition styles below
		const transition = doc.startViewTransition(() => apply(next));
		transition.finished.finally(() => root.classList.remove('theme-switching'));
		transition.ready.then(() => {
			root.animate(
				{ '--tt-r': ['0px', `${radius}px`] },
				{
					duration: 900,
					easing: 'cubic-bezier(0.45, 0, 0.2, 1)',
					pseudoElement: '::view-transition-new(root)',
				}
			);
		});
	});

	// If the visitor never chose, keep following their device setting
	deviceDark.addEventListener('change', (e) => {
		try {
			if (localStorage.getItem('theme')) return;
		} catch {}
		apply(e.matches ? 'dark' : 'light');
	});
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		/* a small piece of glass, matching the glass behind the menu's current page */
		border: 1px solid var(--lens-rim, rgba(255, 255, 255, 0.35));
		border-radius: 999px;
		background:
			linear-gradient(to bottom, var(--lens-sheen, rgba(255, 255, 255, 0.22)), transparent 70%),
			var(--lens-tint, rgba(255, 255, 255, 0.1));
		-webkit-backdrop-filter: blur(8px) saturate(1.6) brightness(1.08);
		backdrop-filter: blur(8px) saturate(1.6) brightness(1.08);
		box-shadow:
			inset 0 1px 0 var(--lens-highlight, rgba(255, 255, 255, 0.55)),
			0 4px 14px var(--lens-shadow, rgba(0, 0, 0, 0.12));
		color: var(--nav-fg, rgb(var(--black)));
		cursor: pointer;
		opacity: 0.9;
		transition:
			opacity 0.25s ease,
			transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		opacity: 1;
		transform: scale(1.08);
	}
	.theme-toggle:active {
		transform: scale(0.92);
	}
	.theme-toggle:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	/* Sun (light mode): bright disc, rays out, nothing cutting into it */
	.core {
		transform-box: view-box;
		transform-origin: 12px 12px;
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.cut {
		transform: translate(14px, -14px);
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.rays {
		transform-box: view-box;
		transform-origin: 12px 12px;
		transition:
			transform 0.6s cubic-bezier(0.65, 0, 0.35, 1),
			opacity 0.4s ease;
	}

	/* Moon (dark mode): the disc grows, a circle slides over it to make a crescent, rays fold away */
	:global(html[data-theme='dark']) .core {
		transform: scale(1.5);
	}
	:global(html[data-theme='dark']) .cut {
		transform: translate(5px, -5px);
	}
	:global(html[data-theme='dark']) .rays {
		transform: rotate(-90deg) scale(0);
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle,
		.core,
		.cut,
		.rays {
			transition: none;
		}
	}
</style>

<style is:global>
	/* The new theme spreads out from the button as a circle with a soft, feathered edge.
	   --tt-r (the circle's size) is registered so the browser can animate it smoothly. */
	@property --tt-r {
		syntax: '<length>';
		inherits: false;
		initial-value: 0px;
	}
	/* (only while switching themes; page-to-page transitions are in global.css) */
	html.theme-switching::view-transition-old(root),
	html.theme-switching::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
	html.theme-switching::view-transition-old(root) {
		z-index: 1;
	}
	/* the header changes colors along with the rest of the page while switching themes */
	html.theme-switching header {
		view-transition-name: none;
	}
	html.theme-switching::view-transition-new(root) {
		z-index: 2147483646;
		-webkit-mask-image: radial-gradient(
			circle at var(--tt-x, 50%) var(--tt-y, 0px),
			#000 max(0px, calc(var(--tt-r) - var(--tt-feather, 140px))),
			transparent var(--tt-r)
		);
		mask-image: radial-gradient(
			circle at var(--tt-x, 50%) var(--tt-y, 0px),
			#000 max(0px, calc(var(--tt-r) - var(--tt-feather, 140px))),
			transparent var(--tt-r)
		);
	}

	/* Fallback for browsers without that feature */
	html.theme-fade :not(.theme-toggle, .theme-toggle *) {
		transition:
			background-color 0.45s ease,
			color 0.45s ease,
			border-color 0.45s ease !important;
	}
</style>
