---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

// Pages where the header floats over a dark page instead of using the solid bar
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isOverlay = path === '/' || path === '/gallery';
---

<header class:list={[{ overlay: isOverlay }]}>
	<nav>
		<a href="/" class="brand">
			<img src="/favicon.svg?v=10" alt="Behr Carey logo" width="32" height="32" />
			<span class="divider">|</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--page-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		justify-self: center;
	}
	.brand {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		font-family: 'Portland', sans-serif;
		font-weight: 100;
		text-transform: uppercase;
		letter-spacing: 0.25em;
	}
	.brand img {
		height: 32px;
		width: auto;
	}
	.divider {
		opacity: 0.5;
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.brand {
			justify-self: center;
		}
	}

	/* Floating header over the home and gallery pages */
	header.overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		background: linear-gradient(to bottom, rgba(10, 14, 25, 0.7), rgba(10, 14, 25, 0));
		box-shadow: none;
	}
	header.overlay nav a,
	header.overlay .brand,
	header.overlay .brand span {
		color: white;
	}
	header.overlay .brand img {
		filter: brightness(0) invert(1);
	}
</style>