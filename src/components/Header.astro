---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Pages where the header floats over a dark page instead of using the solid bar
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isOverlay = path === '/' || path === '/gallery';
---

<header class:list={[{ overlay: isOverlay, 'over-photo': path === '/' }]}>
	<nav>
		<a href="/" class="brand">
			<img src="/favicon.svg?v=10" alt="Behr Carey logo" width="32" height="32" />
			<span class="divider">|</span>
			<span>{SITE_TITLE}</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="nav-end"><ThemeToggle /></div>
	</nav>
</header>
<style>
	header {
		position: relative;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: var(--page-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}

	/* Nav links: underline sweeps in from the left on hover, out to the right on leave */
	.internal-links a {
		position: relative;
		transition: opacity 0.3s ease;
	}
	.internal-links a::after {
		content: '';
		position: absolute;
		left: 0.5em;
		right: 0.5em;
		bottom: 0.6em;
		height: 2px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.internal-links a:hover::after,
	.internal-links a:focus-visible::after,
	.internal-links a.active::after {
		transform: scaleX(1);
		transform-origin: left;
	}
	/* While hovering the nav, the other links dim slightly */
	.internal-links:hover a:not(:hover) {
		opacity: 0.55;
	}
	.internal-links {
		justify-self: center;
	}
	.brand {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		font-family: 'Portland', sans-serif;
		font-weight: 100;
		text-transform: uppercase;
		letter-spacing: 0.25em;
	}
	.brand img {
		height: 32px;
		width: auto;
	}
	.divider {
		opacity: 0.5;
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.brand {
			justify-self: center;
		}
	}

	/* Floating header over the home and gallery pages */
	header.overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		background: linear-gradient(to bottom, rgba(10, 14, 25, 0.7), rgba(10, 14, 25, 0));
		box-shadow: none;
	}
	header.overlay nav a,
	header.overlay .brand,
	header.overlay .brand span {
		color: white;
	}
	header.overlay .brand img {
		filter: brightness(0) invert(1);
	}

	/* Pinned state: after you scroll past the top, the header leaves the page flow and
	   waits just above the screen. Scrolling up slides it down; scrolling down sends it back up. */
	header.is-fixed {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		transform: translateY(-100%);
		transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
	}
	header.is-fixed.is-shown,
	header.is-fixed:focus-within {
		transform: none;
		transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The floating header gets a dark frosted backdrop while pinned, so it stays readable over photos */
	header.overlay::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgba(10, 14, 25, 0.9);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		opacity: 0;
		transition: opacity 0.5s ease;
	}
	header.overlay.is-fixed::before {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		header.is-fixed,
		header.is-fixed.is-shown,
		header.overlay::before,
		.internal-links a,
		.internal-links a::after {
			transition: none;
		}
	}
	/* Light / dark mode */
	.nav-end {
		justify-self: end;
	}
	@media (max-width: 720px) {
		.nav-end {
			position: absolute;
			top: 0.55rem;
			right: 1em;
		}
	}

	/* The floating header's colors come from three variables, so they can follow the theme */
	header.overlay {
		--nav-fg: #fff;
		--nav-img: brightness(0) invert(1);
		--nav-backdrop: rgba(10, 14, 25, 0.9);
	}
	header.overlay nav a,
	header.overlay .brand,
	header.overlay .brand span {
		color: var(--nav-fg);
	}
	header.overlay .brand img {
		filter: var(--nav-img);
	}
	header.overlay::before {
		background: var(--nav-backdrop);
	}
	/* Light mode: dark text and a pale backdrop once pinned, and on the gallery (no photo behind the bar) */
	:global(:root[data-theme='light']) header.overlay.is-fixed,
	:global(:root[data-theme='light']) header.overlay:not(.over-photo) {
		--nav-fg: #111827;
		--nav-img: none;
		--nav-backdrop: rgba(245, 243, 238, 0.92);
	}
	:global(:root[data-theme='light']) header.overlay.is-fixed {
		background: none;
	}
	:global(:root[data-theme='light']) header.overlay:not(.over-photo):not(.is-fixed) {
		background: linear-gradient(to bottom, rgba(245, 243, 238, 0.85), rgba(245, 243, 238, 0));
	}
	/* The About page's bar */
	header:not(.overlay) nav a {
		color: rgb(var(--black));
	}
	:global(:root[data-theme='dark']) header:not(.overlay) .brand img {
		filter: brightness(0) invert(1);
	}	
</style>

<script>
// On a refresh, always start at the top (back and forward buttons still return you to your spot)
const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
if (nav?.type === 'reload') {
	history.scrollRestoration = 'manual';
	window.scrollTo(0, 0);
	window.addEventListener('load', () => {
		window.scrollTo(0, 0);
		history.scrollRestoration = 'auto';
	});
}
	const header = document.querySelector('header') as HTMLElement;
	const isOverlay = header.classList.contains('overlay');
	let spacer: HTMLElement | null = null;
	let lastY = window.scrollY;
	let waiting = false;

	// Take the header out of the page flow, parked just above the screen (no animation)
	function pin() {
		if (header.classList.contains('is-fixed')) return;
		if (!isOverlay) {
			// keep the page content from jumping up when the header leaves the flow
			spacer = document.createElement('div');
			spacer.style.height = `${header.offsetHeight}px`;
			header.after(spacer);
		}
		header.style.transition = 'none';
		header.classList.add('is-fixed');
		void header.offsetHeight; // apply that state before animating
		header.style.transition = '';
	}

	// Put the header back to its normal place at the top of the page
	function unpin() {
		if (!header.classList.contains('is-fixed')) return;
		header.style.transition = 'none';
		header.classList.remove('is-fixed', 'is-shown');
		spacer?.remove();
		spacer = null;
		void header.offsetHeight;
		header.style.transition = '';
	}

	function update() {
		const y = Math.max(window.scrollY, 0);
		const dy = y - lastY;

		if (y <= 4) {
			// back at the very top: the header returns to its normal spot
			unpin();
			lastY = y;
		} else if (Math.abs(dy) > 6) {
			if (dy < 0) {
				// scrolling up: slide the header down
				pin();
				header.classList.add('is-shown');
			} else {
				// scrolling down: slide it away (if it's showing)
				header.classList.remove('is-shown');
			}
			lastY = y;
		}
		waiting = false;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!waiting) {
				waiting = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true }
	);
</script>
