---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Pages where the header floats over a dark page instead of using the solid bar.
// A page can also ask for it directly: <Header overPhoto /> floats it over a full-screen photo
// (used by the "page not found" page, whose address could be anything).
interface Props {
	overPhoto?: boolean;
}
const { overPhoto = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isOverlay = overPhoto || path === '/' || path === '/gallery' || path === '/about';
const isOverPhoto = overPhoto || path === '/';
---

<header class:list={[{ overlay: isOverlay, 'over-photo': isOverPhoto }]}>
	<nav>
		<a href="/" class="brand">
			<span class="brand-mark" role="img" aria-label="Behr Carey logo"></span>
			<span class="divider">|</span>
			<span>{SITE_TITLE}</span>
		</a>

		<div class="internal-links">
			<!-- the sliding piece of glass behind the current / hovered link (see "Glass lens" below) -->
			<span class="nav-lens" aria-hidden="true"><span class="nav-lens-shape"></span></span>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="nav-end"><ThemeToggle /></div>
	</nav>
</header>
<style>
	header {
		position: relative;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: var(--page-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}

	/* ---- Glass lens --------------------------------------------------------
	   Like the selected tab in Apple's Liquid Glass tab bars: a lighter piece of glass sits
	   behind the current page's link. Point at another link and it glides over with a soft
	   spring, stretching a little as it moves and gently magnifying the word it lands on.
	   Move away and it glides back to the current page. (Positioned by the script below.) */
	.internal-links {
		position: relative;
		display: flex;
		align-items: center;
	}
	.internal-links a {
		position: relative;
		z-index: 1;
		transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.3s ease;
	}
	.internal-links a.is-lensed {
		transform: scale(1.06); /* the glass magnifies the word under it */
	}
	.nav-lens {
		position: absolute;
		top: 50%;
		left: 0;
		z-index: 0;
		width: var(--lens-w, 0px);
		height: 2.35em;
		margin-top: -1.175em;
		transform: translateX(var(--lens-x, 0px));
		opacity: 0;
		pointer-events: none;
		transition:
			transform 0.55s cubic-bezier(0.34, 1.3, 0.64, 1),
			width 0.55s cubic-bezier(0.34, 1.3, 0.64, 1),
			opacity 0.3s ease;
	}
	.nav-lens.is-on {
		opacity: 1;
	}
	.nav-lens.no-anim {
		transition: none;
	}
	.nav-lens-shape {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 999px;
		background:
			linear-gradient(to bottom, var(--lens-sheen, rgba(255, 255, 255, 0.22)), transparent 70%),
			var(--lens-tint, rgba(255, 255, 255, 0.1));
		border: 1px solid var(--lens-rim, rgba(255, 255, 255, 0.35));
		-webkit-backdrop-filter: blur(6px) saturate(1.6) brightness(1.1);
		backdrop-filter: blur(6px) saturate(1.6) brightness(1.1);
		box-shadow:
			inset 0 1px 0 var(--lens-highlight, rgba(255, 255, 255, 0.55)),
			inset 0 -1px 2px rgba(255, 255, 255, 0.08),
			0 4px 14px var(--lens-shadow, rgba(0, 0, 0, 0.12));
	}
	.internal-links {
		justify-self: center;
	}
	.brand {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 400;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.3em;
	}
	/* The BC monogram. It's drawn in the same color as the text next to it (currentColor),
	   so it always follows the site's light / dark setting instead of the device's. */
	.brand-mark {
		display: block;
		width: 32px;
		height: 32px;
		flex: none;
	}
	.brand-mark::before {
		content: '';
		display: block;
		width: 100%;
		height: 100%;
		background-color: currentColor;
		-webkit-mask: url('/logo-mark.png') center / contain no-repeat;
		mask: url('/logo-mark.png') center / contain no-repeat;
	}
	.divider {
		opacity: 0.5;
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.brand {
			justify-self: center;
		}
	}

	/* Floating header over the home and gallery pages */
	header.overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		background: linear-gradient(to bottom, rgba(10, 14, 25, 0.7), rgba(10, 14, 25, 0));
		box-shadow: none;
	}
	header.overlay nav a,
	header.overlay .brand,
	header.overlay .brand span {
		color: white;
	}

	/* Pinned state: after you scroll past the top, the header leaves the page flow and
	   waits just above the screen. Scrolling up slides it down; scrolling down sends it back up. */
	header.is-fixed {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		transform: translateY(-100%);
		transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
	}
	header.is-fixed.is-shown,
	header.is-fixed:focus-within {
		transform: none;
		transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The floating header gets a dark frosted backdrop while pinned, so it stays readable over photos */
	header.overlay::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgba(10, 14, 25, 0.9);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		opacity: 0;
		transition: opacity 0.5s ease;
	}
	header.overlay.is-fixed::before {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		header.is-fixed,
		header.is-fixed.is-shown,
		header.overlay::before,
		.internal-links a,
		.nav-lens {
			transition: none;
		}
	}
	/* Light / dark mode */
	.nav-end {
		justify-self: end;
	}
	@media (max-width: 720px) {
		.nav-end {
			position: absolute;
			top: 0.55rem;
			right: 1em;
		}
	}

	/* The floating header's colors come from three variables, so they can follow the theme */
	header.overlay {
		--nav-fg: #fff;
		--nav-backdrop: rgba(10, 14, 25, 0.9);
	}
	header.overlay nav a,
	header.overlay .brand,
	header.overlay .brand span {
		color: var(--nav-fg);
	}
	header.overlay::before {
		background: var(--nav-backdrop);
	}
	/* Light mode: dark text and a pale backdrop once pinned, and on the gallery (no photo behind the bar) */
	:global(:root[data-theme='light']) header.overlay.is-fixed,
	:global(:root[data-theme='light']) header.overlay:not(.over-photo) {
		--nav-fg: #111827;
		--nav-backdrop: rgba(245, 243, 238, 0.92);
	}
	:global(:root[data-theme='light']) header.overlay.is-fixed {
		background: none;
	}
	:global(:root[data-theme='light']) header.overlay:not(.over-photo):not(.is-fixed) {
		background: linear-gradient(to bottom, rgba(245, 243, 238, 0.85), rgba(245, 243, 238, 0));
	}
	/* Glass lens on light backgrounds (light mode bars, and the plain bar on other pages):
	   a bright, milky piece of glass with a faint dark edge so it still reads */
	:global(:root[data-theme='light']) header.overlay.is-fixed,
	:global(:root[data-theme='light']) header.overlay:not(.over-photo),
	header:not(.overlay) {
		--lens-tint: rgba(255, 255, 255, 0.55);
		--lens-sheen: rgba(255, 255, 255, 0.7);
		--lens-rim: rgba(17, 24, 39, 0.08);
		--lens-highlight: rgba(255, 255, 255, 0.95);
		--lens-shadow: rgba(17, 24, 39, 0.1);
	}
	/* The plain bar used on pages without a photo behind the header (like "page not found") */
	header:not(.overlay) nav a {
		color: rgb(var(--black));
	}
	header:not(.overlay) .brand {
		color: rgb(var(--black));
	}
</style>

<script>
// On a refresh, always start at the top (back and forward buttons still return you to your spot)
const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
if (nav?.type === 'reload') {
	history.scrollRestoration = 'manual';
	window.scrollTo(0, 0);
	window.addEventListener('load', () => {
		window.scrollTo(0, 0);
		history.scrollRestoration = 'auto';
	});
}
	const header = document.querySelector('header') as HTMLElement;
	const isOverlay = header.classList.contains('overlay');
	let spacer: HTMLElement | null = null;
	let lastY = window.scrollY;
	let waiting = false;

	// Take the header out of the page flow, parked just above the screen (no animation)
	function pin() {
		if (header.classList.contains('is-fixed')) return;
		if (!isOverlay) {
			// keep the page content from jumping up when the header leaves the flow
			spacer = document.createElement('div');
			spacer.style.height = `${header.offsetHeight}px`;
			header.after(spacer);
		}
		header.style.transition = 'none';
		header.classList.add('is-fixed');
		void header.offsetHeight; // apply that state before animating
		header.style.transition = '';
	}

	// Put the header back to its normal place at the top of the page
	function unpin() {
		if (!header.classList.contains('is-fixed')) return;
		header.style.transition = 'none';
		header.classList.remove('is-fixed', 'is-shown');
		spacer?.remove();
		spacer = null;
		void header.offsetHeight;
		header.style.transition = '';
	}

	function update() {
		const y = Math.max(window.scrollY, 0);
		const dy = y - lastY;

		if (y <= 4) {
			// back at the very top: the header returns to its normal spot
			unpin();
			lastY = y;
		} else if (Math.abs(dy) > 6) {
			if (dy < 0) {
				// scrolling up: slide the header down
				pin();
				header.classList.add('is-shown');
			} else {
				// scrolling down: slide it away (if it's showing)
				header.classList.remove('is-shown');
			}
			lastY = y;
		}
		waiting = false;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!waiting) {
				waiting = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true }
	);

	// ---- Glass lens ----------------------------------------------------------
	const linksBox = header.querySelector<HTMLElement>('.internal-links');
	const lens = header.querySelector<HTMLElement>('.nav-lens');
	const lensShape = header.querySelector<HTMLElement>('.nav-lens-shape');
	if (linksBox && lens && lensShape) {
		const links = [...linksBox.querySelectorAll<HTMLAnchorElement>('a')];
		const current = links.find((a) => a.classList.contains('active')) ?? null;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let target: HTMLAnchorElement | null = null;

		// Move the glass behind a link (or hide it if there's no link to sit behind)
		function moveTo(link: HTMLAnchorElement | null, animate = true) {
			// appearing from nowhere: place it first, then just fade it in
			if (!lens!.classList.contains('is-on')) animate = false;
			if (!animate || reduce) lens!.classList.add('no-anim');
			links.forEach((a) => a.classList.toggle('is-lensed', a === link && link !== current));
			if (!link) {
				lens!.classList.remove('is-on');
			} else {
				const extra = 6; // a little wider than the word
				lens!.style.setProperty('--lens-x', `${link.offsetLeft - extra / 2}px`);
				lens!.style.setProperty('--lens-w', `${link.offsetWidth + extra}px`);
				// a liquid stretch while it travels between links, then it settles
				if (animate && !reduce && target && link !== target && lens!.classList.contains('is-on')) {
					lensShape!.animate(
						[
							{ transform: 'scale(1, 1)' },
							{ transform: 'scale(1.14, 0.88)', offset: 0.35 },
							{ transform: 'scale(0.97, 1.03)', offset: 0.7 },
							{ transform: 'scale(1, 1)' },
						],
						{ duration: 560, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
					);
				}
				lens!.classList.add('is-on');
			}
			target = link;
			if (!animate || reduce) {
				void lens!.offsetWidth;
				lens!.classList.remove('no-anim');
			}
		}

		links.forEach((a) => {
			a.addEventListener('mouseenter', () => moveTo(a));
			a.addEventListener('focus', () => moveTo(a));
		});
		linksBox.addEventListener('mouseleave', () => moveTo(current));
		linksBox.addEventListener('focusout', (e) => {
			if (!linksBox.contains(e.relatedTarget as Node)) moveTo(current);
		});

		// Start on the current page's link, and keep it lined up when the bar changes size
		// (pinning changes the link spacing) or the fonts finish loading
		const settle = () => moveTo(target ?? current, false);
		settle();
		document.fonts?.ready.then(settle);
		window.addEventListener('resize', settle);
		new MutationObserver(settle).observe(header, { attributes: true, attributeFilter: ['class'] });
	}
</script>
