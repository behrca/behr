---
// PhotoGuard: makes the photos harder to save, on every page (it's included by Footer.astro).
//   - right-clicking a photo shows "© Behr Carey. All rights reserved." instead of the
//     browser menu (so there's no "Save Image As…")
//   - photos can't be dragged out onto the desktop
//   - on iPhone / iPad, long-pressing a photo doesn't offer "Save to Photos"
// It covers real images and background photos alike (hero, cards, featured photo, footer).
// Map tiles are left alone; they belong to OpenStreetMap, not to you.
//
// Honest note: nothing on a website can make photos impossible to copy (screenshots and
// developer tools always work). This stops casual saving, which is most of it.
---

<div class="photo-guard-tip" id="photo-guard-tip" role="status" aria-live="polite">
	© Behr Carey. All rights reserved.
</div>

<script>
	const tip = document.getElementById('photo-guard-tip') as HTMLElement;
	let tipTimer: number | undefined;

	const PHOTO_BG = /url\(["']?[^"')]*\.(jpe?g|png|webp|avif)/i;
	const isMapTile = (el: Element) => !!el.closest('.leaflet-container');

	// Is this element one of the photos? (an image, or something with a photo as its background)
	function isPhoto(el: Element) {
		if (isMapTile(el)) return false;
		if (el instanceof HTMLImageElement) return true;
		return PHOTO_BG.test(getComputedStyle(el).backgroundImage);
	}

	// Photos often sit behind text or links, so look at everything under the pointer
	function photoUnder(x: number, y: number) {
		return document.elementsFromPoint(x, y).some(isPhoto);
	}

	// The notice is placed on the page itself (not fixed to the screen), so if you scroll,
	// it scrolls away with the photo you clicked.
	function showTip(x: number, y: number) {
		const half = tip.offsetWidth / 2 + 12;
		const left = Math.min(Math.max(x, half), window.innerWidth - half);
		const top = Math.max(y - 12, tip.offsetHeight + 12);
		tip.style.left = `${left + window.scrollX}px`;
		tip.style.top = `${top + window.scrollY}px`;
		tip.classList.add('show');
		window.clearTimeout(tipTimer);
		tipTimer = window.setTimeout(() => tip.classList.remove('show'), 1000); // on screen for 1 second
	}

	document.addEventListener('contextmenu', (e) => {
		if (photoUnder(e.clientX, e.clientY)) {
			e.preventDefault();
			showTip(e.clientX, e.clientY);
		}
	});

	// stop photos from being dragged out of the page onto the desktop
	document.addEventListener('dragstart', (e) => {
		const el = e.target as Element;
		if (el instanceof Element && (isPhoto(el) || el.querySelector?.('img') || photoUnder(e.clientX, e.clientY))) {
			e.preventDefault();
		}
	});
</script>

<style is:global>
	/* no dragging photos out, and no "Save to Photos" on a long-press (iPhone / iPad) */
	img:not(.leaflet-tile) {
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
		user-select: none;
	}

	/* the small "© Behr Carey" notice that appears where you right-clicked.
	   It sits on the page (position: absolute), so it scrolls away with the photo. */
	.photo-guard-tip {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2000;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		background: rgba(15, 18, 25, 0.62);
		-webkit-backdrop-filter: blur(10px) saturate(1.4);
		backdrop-filter: blur(10px) saturate(1.4);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		opacity: 0;
		transform: translate(-50%, calc(-100% + 4px));
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
		pointer-events: none;
	}
	:root[data-theme='light'] .photo-guard-tip {
		background: rgba(255, 255, 255, 0.72);
		border-color: rgba(17, 24, 39, 0.08);
		color: rgba(17, 24, 39, 0.75);
	}
	.photo-guard-tip.show {
		opacity: 1;
		transform: translate(-50%, -100%);
	}
	@media (prefers-reduced-motion: reduce) {
		.photo-guard-tip {
			transition: none;
		}
	}
</style>
