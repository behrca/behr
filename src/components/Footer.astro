---
const today = new Date();
---

<footer>
	<div class="inner">
		<h2>Behr Carey</h2>
		<p class="subtitle">Aviation • Wildlife • Nature</p>
		<nav>
			<a href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
		</nav>
		<hr />
		<p class="copyright">© {today.getFullYear()} Behr Carey. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		display: block;
		padding: 3rem 6vw 2rem;
		text-align: center;
		color: rgba(255, 255, 255, 0.7);
		background-image:
			linear-gradient(to bottom, rgba(10, 14, 25, 0.88), rgba(10, 14, 25, 0.95)),
			url('/footer.jpg');
		background-size: cover;
		background-position: center 40%;
	}
	footer .inner {
		max-width: 700px;
		margin: 0 auto;
	}
	footer h2 {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin: 0;
		font-size: 1.6rem;
		font-weight: 400;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: white;
	}
	footer h2::before,
	footer h2::after {
		content: '';
		flex: 1;
		height: 1px;
		background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.4));
	}
	footer h2::after {
		background: linear-gradient(to left, transparent, rgba(255, 255, 255, 0.4));
	}
	footer .subtitle {
		margin: 0.75rem 0 1.75rem;
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}
	footer nav {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
	}
	footer nav a {
		padding: 0 1.5rem;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 0.95rem;
		letter-spacing: normal;
		text-transform: none;
	}
	footer nav a + a {
		border-left: 1px solid rgba(255, 255, 255, 0.25);
	}
	footer nav a:hover {
		color: white;
	}
	footer hr {
		width: 60%;
		margin: 1.75rem auto 1.25rem;
		border: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
	}
	footer .copyright {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: normal;
		color: rgba(255, 255, 255, 0.55);
	}
	@media (max-width: 600px) {
		footer h2::before,
		footer h2::after {
			display: none;
		}
	}
</style>