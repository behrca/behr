---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Photography by Behr Carey</p>
				<h1>Capturing<br />Life’s <em>Beauty</em></h1>
				<p class="tagline">Nature. Aviation. More.</p>
				<a class="button" href="/blog">View my work →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		padding: 0;
	}
	.hero {
		min-height: 90vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		padding: 2rem 6vw;
		color: white;
		background-image:
			linear-gradient(to right, rgba(10, 14, 25, 0.85), rgba(10, 14, 25, 0.15)),
			url('/hero.jpg');
		background-size: cover;
		background-position: center;
	}
	.eyebrow {
		letter-spacing: 0.3em;
		text-transform: uppercase;
		font-size: 0.8rem;
		margin: 0 0 1rem;
	}
	h1 {
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 1;
		margin: 0 0 1.5rem;
		color: white;
	}
	h1 em {
		color: #6fa0e8;
	}
	.tagline {
		letter-spacing: 0.15em;
		margin: 0 0 2rem;
	}
	.button {
		border: 2px solid white;
		color: white;
		padding: 0.9rem 1.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-size: 0.8rem;
		text-decoration: none;
	}
	.button:hover {
		background: white;
		color: black;
	}
</style>