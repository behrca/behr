---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="backgrounds">
					<div class="bg active" style="background-image: url('/hero.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-2.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-3.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-4.jpg')"></div>
				</div>
				<div class="overlay"></div>

				<div class="content">
					<p class="eyebrow">Photography by Behr Carey</p>
					<h1>
						Capturing<br />Life’s
						<span class="words">
							<em class="word active">Beauty</em>
							<em class="word">Wonder</em>
							<em class="word">Freedom</em>
							<em class="word">Journeys</em>
						</span>
					</h1>
					<p class="tagline">Nature. Aviation. More.</p>
					<a class="button" href="/blog">View my work →</a>
				</div>
			</section>

			<section class="disciplines">
				<div class="section-header">
					<p class="section-eyebrow">Specialty</p>
					<h2 class="section-title">What I Shoot</h2>
				</div>

				<div class="cards">
					<div class="card">
						<div class="card-bg" style="background-image: url('/hero.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Nature</h3>
							<p>Rivers, mountains, and big open country. The quiet, wild side of the outdoors.</p>
							<a class="card-button" href="/blog">View Nature →</a>
						</div>
					</div>

					<div class="card">
						<div class="card-bg" style="background-image: url('/hero-3.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Aviation</h3>
							<p>Helicopters, airliners, and everything that flies, caught where they work.</p>
							<a class="card-button" href="/blog">View Aviation →</a>
						</div>
					</div>

					<div class="card">
						<div class="card-bg" style="background-image: url('/hero-2.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Wildlife</h3>
							<p>Whales, birds, and the moments that only last a second.</p>
							<a class="card-button" href="/blog">View Wildlife →</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const bgs = document.querySelectorAll('.bg');
	const words = document.querySelectorAll('.word');
	const SECONDS_PER_SLIDE = 6;
	let current = 0;

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion) {
		setInterval(() => {
			bgs[current].classList.remove('active');
			words[current].classList.remove('active');
			current = (current + 1) % bgs.length;
			bgs[current].classList.add('active');
			words[current].classList.add('active');
		}, SECONDS_PER_SLIDE * 1000);
	}
</script>

<style>
	main {
		width: 100%;
		max-width: 100%;
		padding: 0;
	}
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		color: white;
	}
	.backgrounds,
	.overlay {
		position: absolute;
		inset: 0;
	}
	.bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0;
		transition: opacity 1.5s ease-in-out;
	}
	.bg.active {
		opacity: 1;
	}
	.overlay {
		background: linear-gradient(to right, rgba(10, 14, 25, 0.85), rgba(10, 14, 25, 0.15));
	}
	.content {
		position: relative;
		padding: 2rem 6vw;
	}
	.eyebrow {
		letter-spacing: 0.3em;
		text-transform: uppercase;
		font-size: 0.8rem;
		margin: 0 0 1rem;
	}
	h1 {
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 1;
		margin: 0 0 1.5rem;
		color: white;
	}
	.words {
		display: inline-grid;
	}
	.word {
		grid-area: 1 / 1;
		color: #6fa0e8;
		opacity: 0;
		transition: opacity 1.5s ease-in-out;
	}
	.word.active {
		opacity: 1;
	}
	.tagline {
		letter-spacing: 0.15em;
		margin: 0 0 2rem;
	}
	.button {
		display: inline-block;
		border: 2px solid white;
		color: white;
		padding: 0.9rem 1.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-size: 0.8rem;
		text-decoration: none;
	}
	.button:hover {
		background: white;
		color: black;
	}

	/* Disciplines section */
	.disciplines {
		background: #0a0e19;
		padding: 5rem 6vw;
	}
	.section-header {
		margin-bottom: 2rem;
	}
	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
	}
	.section-eyebrow::after {
		content: '';
		width: 120px;
		height: 1px;
		background: rgba(255, 255, 255, 0.3);
	}
	.section-title {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: white;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 520px;
		padding: 1.75rem;
		border-radius: 16px;
		overflow: hidden;
		isolation: isolate;
	}
	.card-bg,
	.card-shade {
		position: absolute;
		inset: 0;
	}
	.card-bg {
		background-size: cover;
		background-position: center;
		transition: transform 0.6s ease;
		z-index: -2;
	}
	.card:hover .card-bg {
		transform: scale(1.05);
	}
	.card-shade {
		background: linear-gradient(to bottom, rgba(10, 14, 25, 0) 30%, rgba(10, 14, 25, 0.95) 85%);
		z-index: -1;
	}
	.card-body h3 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
		color: white;
	}
	.card-body p {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.8);
	}
	.card-button {
		display: inline-block;
		padding: 0.6rem 1rem;
		border: 1.5px solid rgba(255, 255, 255, 0.7);
		border-radius: 8px;
		background: rgba(10, 14, 25, 0.4);
		color: white;
		font-size: 0.85rem;
		text-decoration: none;
	}
	.card-button:hover {
		background: white;
		color: black;
	}
	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
		}
		.card {
			min-height: 420px;
		}
	}
</style>