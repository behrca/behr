---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Intro from '../components/Intro.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
	  <Intro />
		<Header />
		<main>
			<div class="page-bg">
				<div class="backgrounds">
					<div class="bg active" style="background-image: url('/hero.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-2.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-3.jpg')"></div>
					<div class="bg" style="background-image: url('/hero-4.jpg')"></div>
				</div>
				<div class="overlay"></div>
				<div class="fade"></div>
			</div>

			<section class="hero">
				<div class="content">
					<p class="eyebrow">Photography by Behr Carey</p>
					<h1>
						Capturing<br />Life’s
						<span class="words">
							<em class="word active">Beauty</em>
							<em class="word">Wonder</em>
							<em class="word">Freedom</em>
							<em class="word">Journeys</em>
						</span>
					</h1>
					<p class="tagline">Nature. Aviation. More.</p>
					<a class="button" href="/gallery">
						<span class="label">View my work</span>
						<span class="arrow" aria-hidden="true">→</span>
					</a>
				</div>

				<a class="scroll-cue" href="#work" aria-label="Scroll down to my work">
					<svg
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<line x1="12" y1="4" x2="12" y2="20"></line>
						<polyline points="6 14 12 20 18 14"></polyline>
					</svg>
				</a>
			</section>

			<section class="disciplines" id="work">
				<div class="section-header">
					<div>
						<p class="section-eyebrow">Specialty</p>
						<h2 class="section-title">Explore My Work</h2>
					</div>
					<a class="view-all" href="/gallery">View all →</a>
				</div>

				<div class="cards">
					<a class="card" href="/gallery">
						<div class="card-bg" style="background-image: url('/nature.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Nature</h3>
							<p>Rivers, mountains, and big open country. The quiet, wild side of the outdoors.</p>
							<span class="card-button">
								<span class="label">View Nature</span>
								<span class="arrow" aria-hidden="true">→</span>
							</span>
						</div>
					</a>

					<a class="card" href="/gallery">
						<div class="card-bg" style="background-image: url('/aviation.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Aviation</h3>
							<p>Helicopters, airliners, and everything that flies, caught where they work.</p>
							<span class="card-button">
								<span class="label">View Aviation</span>
								<span class="arrow" aria-hidden="true">→</span>
							</span>
						</div>
					</a>

					<a class="card" href="/gallery">
						<div class="card-bg" style="background-image: url('/wildlife.jpg')"></div>
						<div class="card-shade"></div>
						<div class="card-body">
							<h3>Wildlife</h3>
							<p>Whales, birds, and the moments that only last a second.</p>
							<span class="card-button">
								<span class="label">View Wildlife</span>
								<span class="arrow" aria-hidden="true">→</span>
							</span>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const bgs = document.querySelectorAll('.bg');
	const words = document.querySelectorAll('.word');
	const SECONDS_PER_SLIDE = 6;
	let current = 0;

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion) {
		setInterval(() => {
			bgs[current].classList.remove('active');
			words[current].classList.remove('active');
			current = (current + 1) % bgs.length;
			bgs[current].classList.add('active');
			words[current].classList.add('active');
		}, SECONDS_PER_SLIDE * 1000);
	}
</script>
<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// Everything below is tied to scroll position: scroll down and it plays,
		// scroll back up and it rewinds. "scrub" is the smoothing in seconds (higher = softer).

		// Heading row: eyebrow and title rise, "View all" slides in from the right.
		// Plays from when the row is just peeking in until it's about 55% of the way up the screen.
		gsap
			.timeline({
				scrollTrigger: {
					trigger: '.section-header',
					start: 'top 95%',
					end: 'top 55%',
					scrub: 0.8,
				},
			})
			.fromTo('.section-eyebrow', { y: 40, opacity: 0 }, { y: 0, opacity: 1, ease: 'none' }, 0)
			.fromTo('.section-title', { y: 40, opacity: 0 }, { y: 0, opacity: 1, ease: 'none' }, 0.15)
			.fromTo('.view-all', { x: 80, opacity: 0 }, { x: 0, opacity: 1, ease: 'none' }, 0.3);

		// Cards: each one rises in, its photo settles from zoomed in, then its text follows.
		// Plays from when the top of the card enters the screen until it's 35% of the way down it,
		// so it's only finished once you're properly looking at the card.
		const wide = window.innerWidth > 900;
		document.querySelectorAll<HTMLElement>('.card').forEach((card, i) => {
			const photo = card.querySelector<HTMLElement>('.card-bg')!;
			const parts = card.querySelectorAll('.card-body > *');
			const d = wide ? i * 0.12 : 0; // side-by-side cards start one after another

			gsap
				.timeline({
					scrollTrigger: {
						trigger: card,
						start: 'top 95%',
						end: 'top 35%',
						scrub: 0.8,
					},
				})
				.fromTo(card, { opacity: 0, y: 100 }, { opacity: 1, y: 0, duration: 0.6, ease: 'none' }, d)
				.fromTo(photo, { '--s': 1.25 }, { '--s': 1, duration: 1, ease: 'none' }, d)
				.fromTo(
					parts,
					{ opacity: 0, y: 24 },
					{ opacity: 1, y: 0, duration: 0.5, ease: 'none', stagger: 0.08 },
					d + 0.35
				);
		});

		window.addEventListener('load', () => ScrollTrigger.refresh());
	}
</script>
<style>
	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}

	main {
		position: relative;
		width: 100%;
		max-width: 100%;
		padding: 0;
		overflow: hidden;
		background: #0a0e19;
	}

	/* Photo layer: scrolls with the page, fades to dark going down */
	.page-bg {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 150vh;
		z-index: 0;
	}
	.backgrounds,
	.overlay,
	.fade {
		position: absolute;
		inset: 0;
	}
	.bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center top;
		opacity: 0;
		transition: opacity 1.5s ease-in-out;
	}
	.bg.active {
		opacity: 1;
	}
	.overlay {
		background: linear-gradient(to right, rgba(10, 14, 25, 0.55), rgba(10, 14, 25, 0));
	}
	.fade {
		background: linear-gradient(
			to bottom,
			rgba(10, 14, 25, 0) 0%,
			rgba(10, 14, 25, 0.05) 30%,
			rgba(10, 14, 25, 0.6) 65%,
			#0a0e19 100%
		);
	}

	.hero {
		position: relative;
		z-index: 1;
		min-height: 100vh;
		display: flex;
		align-items: center;
		color: white;
	}
	.content {
		position: relative;
		padding: 2rem 6vw;
	}
	.eyebrow {
		letter-spacing: 0.3em;
		text-transform: uppercase;
		font-size: 0.8rem;
		margin: 0 0 1rem;
	}
	h1 {
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 1;
		margin: 0 0 1.5rem;
		color: white;
	}

	/* Changing word: focus pull, timed to match the photo crossfade (1.5s, same easing) */
	.words {
		display: inline-grid;
	}
	.word {
		grid-area: 1 / 1;
		color: #6fa0e8;
		opacity: 0;
		filter: blur(10px);
		transition:
			opacity 1.5s ease-in-out,
			filter 1.5s ease-in-out;
	}
	.word.active {
		opacity: 1;
		filter: blur(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.word {
			transition: none;
			filter: none;
		}
	}

	.tagline {
		letter-spacing: 0.15em;
		margin: 0 0 2rem;
	}

	/* View my work button: white fill sweeps in from the left on hover */
	.button {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		border: 2px solid white;
		color: white;
		padding: 0.9rem 1.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-size: 0.8rem;
		text-decoration: none;
		transition: color 0.35s ease;
	}
	.button::before {
		content: '';
		position: absolute;
		inset: 0;
		background: white;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
		z-index: -1;
	}
	.button .arrow {
		display: inline-block;
		transition: transform 0.35s ease;
	}
	.button:hover,
	.button:focus-visible {
		color: #0a0e19;
	}
	.button:hover::before,
	.button:focus-visible::before {
		transform: scaleX(1);
	}
	.button:hover .arrow,
	.button:focus-visible .arrow {
		transform: translateX(5px);
	}
	@media (prefers-reduced-motion: reduce) {
		.button,
		.button::before,
		.button .arrow {
			transition: none;
		}
	}

	/* Scroll cue: outlined pill with a gently bobbing arrow */
	.scroll-cue {
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 54px;
		box-sizing: border-box;
		border: 2px solid rgba(255, 255, 255, 0.85);
		border-radius: 999px;
		color: white;
		text-decoration: none;
		transition: background 0.3s ease;
	}
	.scroll-cue:hover {
		background: rgba(255, 255, 255, 0.15);
	}
	.scroll-cue svg {
		animation: cue-bob 2.5s ease-in-out infinite;
	}
	@keyframes cue-bob {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(4px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scroll-cue svg {
			animation: none;
		}
	}

	/* Disciplines section */
	.disciplines {
		position: relative;
		z-index: 1;
		padding: 5rem 6vw;
		scroll-margin-top: 1rem;
	}
	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.section-eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
	}
	.section-eyebrow::after {
		content: '';
		width: 120px;
		height: 1px;
		background: rgba(255, 255, 255, 0.3);
	}
	.section-title {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: white;
	}
	.view-all {
		padding-bottom: 0.3rem;
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}
	.view-all:hover {
		color: white;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	/* The whole card is one link */
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 520px;
		padding: 1.75rem;
		border-radius: 16px;
		overflow: hidden;
		isolation: isolate;
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}
	.card:focus-visible {
		outline: 2px solid white;
		outline-offset: 3px;
	}
	.card-bg,
	.card-shade {
		position: absolute;
		inset: 0;
	}
	.card-bg {
		background-size: cover;
		background-position: center;
		transition: transform 0.6s ease;
		z-index: -2;
	}
	.card:hover .card-bg,
	.card:focus-visible .card-bg {
		transform: scale(1.05);
	}
	.card-shade {
		background: linear-gradient(to bottom, rgba(10, 14, 25, 0) 30%, rgba(10, 14, 25, 0.95) 85%);
		z-index: -1;
	}
	.card-body h3 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
		color: white;
	}
	.card-body p {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.8);
	}

	/* Card button: same white sweep, triggered by hovering anywhere on the card */
	.card-button {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1rem;
		border: 1.5px solid rgba(255, 255, 255, 0.7);
		border-radius: 8px;
		background: rgba(10, 14, 25, 0.4);
		color: white;
		font-size: 0.85rem;
		transition: color 0.35s ease;
	}
	.card-button::before {
		content: '';
		position: absolute;
		inset: 0;
		background: white;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
		z-index: -1;
	}
	.card-button .arrow {
		display: inline-block;
		transition: transform 0.35s ease;
	}
	.card:hover .card-button,
	.card:focus-visible .card-button {
		color: #0a0e19;
	}
	.card:hover .card-button::before,
	.card:focus-visible .card-button::before {
		transform: scaleX(1);
	}
	.card:hover .card-button .arrow,
	.card:focus-visible .card-button .arrow {
		transform: translateX(5px);
	}
	@media (prefers-reduced-motion: reduce) {
		.card-bg,
		.card-button,
		.card-button::before,
		.card-button .arrow {
			transition: none;
		}
	}

	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
		}
		.card {
			min-height: 420px;
		}
	}
</style>