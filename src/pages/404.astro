---
// "Page not found": the page becomes a camera viewfinder that can't find focus.
// The photo hunts for focus like autofocus does (blurring in and out), never quite locks
// on, and settles slightly soft. The readout along the bottom is all 404s.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const photo = '/inside-passage-mist.jpg'; // any photo from /public works here
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="This page doesn't exist." />
	</head>
	<body>
		<Header overPhoto />
		<main class="lost">
			<div class="lost-photo" style={`background-image: url('${photo}')`}></div>
			<div class="lost-shade"></div>

			<div class="viewfinder">
				<span class="corner tl" aria-hidden="true"></span>
				<span class="corner tr" aria-hidden="true"></span>
				<span class="corner bl" aria-hidden="true"></span>
				<span class="corner br" aria-hidden="true"></span>
				<span class="af-point" aria-hidden="true"></span>

				<div class="copy">
					<p class="eyebrow">Error 404</p>
					<h1>This page is out of focus.</h1>
					<p class="text">The link may be old or mistyped. Everything that’s sharp is in the gallery.</p>
					<div class="actions">
						<a class="glass-btn primary" href="/gallery">
							<span>Open the gallery</span>
							<span class="arrow" aria-hidden="true">→</span>
						</a>
						<a class="glass-btn" href="/">Home</a>
					</div>
				</div>

				<div class="readout" aria-hidden="true">
					<span>404mm</span>
					<span>f/4.04</span>
					<span>1/404s</span>
					<span>ISO 404</span>
					<span class="af">AF</span>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	import { gsap } from 'gsap';

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const photo = document.querySelector<HTMLElement>('.lost-photo')!;
	const af = document.querySelector<HTMLElement>('.af-point')!;
	const afLabel = document.querySelector<HTMLElement>('.readout .af')!;

	if (!reduceMotion) {
		// Autofocus hunting: blurry, nearly sharp, blurry again, then it gives up slightly soft.
		// The focus square blinks while it searches, then turns amber: focus not found.
		gsap
			.timeline({ delay: 0.25 })
			.fromTo(photo, { '--blur': '18px', scale: 1.08 }, { '--blur': '2px', scale: 1.03, duration: 1.1, ease: 'power2.inOut' })
			.to(photo, { '--blur': '9px', duration: 0.45, ease: 'power1.inOut' })
			.to(photo, { '--blur': '3px', duration: 0.4, ease: 'power1.inOut' })
			.to(photo, { '--blur': '5px', scale: 1.02, duration: 0.6, ease: 'power2.out' })
			.fromTo(af, { opacity: 0.3 }, { opacity: 1, duration: 0.18, repeat: 7, yoyo: true, ease: 'none' }, 0)
			.call(() => {
				af.classList.add('missed');
				afLabel.classList.add('missed');
			})
			.fromTo(
				'.viewfinder .copy > *',
				{ y: 24, opacity: 0 },
				{ y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', stagger: 0.1, clearProps: 'transform' },
				0.9
			)
			.fromTo('.readout, .corner', { opacity: 0 }, { opacity: 1, duration: 0.8, ease: 'power1.out' }, 0.2);

		// The photo drifts a little with the mouse, like moving the camera slightly
		const moveX = gsap.quickTo(photo, 'x', { duration: 1.2, ease: 'power3.out' });
		const moveY = gsap.quickTo(photo, 'y', { duration: 1.2, ease: 'power3.out' });
		window.addEventListener('pointermove', (e) => {
			moveX((e.clientX / window.innerWidth - 0.5) * -24);
			moveY((e.clientY / window.innerHeight - 0.5) * -16);
		});
	} else {
		af.classList.add('missed');
		afLabel.classList.add('missed');
	}
</script>

<style>
	main.lost {
		position: relative;
		box-sizing: border-box; /* the padding counts inside the full width, so nothing spills sideways */
		width: 100%;
		max-width: 100%;
		min-height: 100vh;
		min-height: 100svh;
		margin: 0;
		padding: 7rem 6vw 4rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: #0a0e19;
		color: white;
	}

	/* The photo, slightly out of focus (--blur is animated by the script) */
	.lost-photo {
		--blur: 5px;
		position: absolute;
		inset: -40px; /* room to drift and to hide the soft edges of the blur */
		background-size: cover;
		background-position: center;
		filter: blur(var(--blur)) saturate(0.9);
		transform: scale(1.02);
	}
	.lost-shade {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at center, rgba(10, 14, 25, 0.25), rgba(10, 14, 25, 0.75) 80%),
			linear-gradient(to bottom, rgba(10, 14, 25, 0.35), rgba(10, 14, 25, 0) 30%, rgba(10, 14, 25, 0.6));
	}

	/* The viewfinder frame */
	.viewfinder {
		position: relative;
		z-index: 1;
		width: min(760px, 100%);
		min-height: min(460px, 70vh);
		display: grid;
		place-items: center;
		padding: 3.5rem 2.5rem 4.5rem;
		text-align: center;
	}
	.corner {
		position: absolute;
		width: 34px;
		height: 34px;
		border: 0 solid rgba(255, 255, 255, 0.75);
	}
	.corner.tl {
		top: 0;
		left: 0;
		border-top-width: 1.5px;
		border-left-width: 1.5px;
	}
	.corner.tr {
		top: 0;
		right: 0;
		border-top-width: 1.5px;
		border-right-width: 1.5px;
	}
	.corner.bl {
		bottom: 0;
		left: 0;
		border-bottom-width: 1.5px;
		border-left-width: 1.5px;
	}
	.corner.br {
		bottom: 0;
		right: 0;
		border-bottom-width: 1.5px;
		border-right-width: 1.5px;
	}
	/* The focus point: white while searching, amber once it gives up */
	.af-point {
		position: absolute;
		top: 1.4rem;
		left: 50%;
		width: 22px;
		height: 16px;
		margin-left: -11px;
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		border-radius: 2px;
		transition: border-color 0.3s ease;
	}
	.af-point.missed {
		border-color: #e8a33d;
	}

	.copy {
		max-width: 34rem;
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
	}
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.72rem;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}
	h1 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(2.2rem, 6vw, 4rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: white;
	}
	.text {
		margin: 0 auto 2.25rem;
		font-size: 1rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.8);
	}

	/* Glass buttons, like the menu and theme switch */
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
	.glass-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.8rem 1.4rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 999px;
		background:
			linear-gradient(to bottom, rgba(255, 255, 255, 0.18), transparent 70%),
			rgba(255, 255, 255, 0.06);
		-webkit-backdrop-filter: blur(14px) saturate(1.6);
		backdrop-filter: blur(14px) saturate(1.6);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 8px 24px rgba(0, 0, 0, 0.2);
		color: white;
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		text-decoration: none;
		text-shadow: none;
		transition:
			background-color 0.3s ease,
			transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1);
	}
	.glass-btn.primary {
		background:
			linear-gradient(to bottom, rgba(255, 255, 255, 0.3), transparent 70%),
			rgba(255, 255, 255, 0.14);
	}
	.glass-btn:hover,
	.glass-btn:focus-visible {
		transform: scale(1.04);
		background-color: rgba(255, 255, 255, 0.12);
	}
	.glass-btn .arrow {
		display: inline-block;
		transition: transform 0.35s ease;
	}
	.glass-btn:hover .arrow,
	.glass-btn:focus-visible .arrow {
		transform: translateX(4px);
	}
	.glass-btn:focus-visible {
		outline: 2px solid white;
		outline-offset: 3px;
	}

	/* Camera-style readout along the bottom of the frame */
	.readout {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1.1rem;
		display: flex;
		justify-content: center;
		gap: 1.6rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		font-variant-numeric: tabular-nums;
		color: rgba(255, 255, 255, 0.75);
	}
	.readout .af {
		padding: 0 0.35rem;
		border: 1px solid currentColor;
		border-radius: 3px;
		transition: color 0.3s ease;
	}
	.readout .af.missed {
		color: #e8a33d;
	}

	/* Hidden until the entrance plays, so nothing flashes first */
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		.viewfinder .copy > *,
		.readout,
		.corner {
			opacity: 0;
		}
		.lost-photo {
			--blur: 18px;
		}
	}

	@media (max-width: 600px) {
		.viewfinder {
			padding: 3rem 1.25rem 4rem;
		}
		.readout {
			gap: 0.9rem;
			font-size: 0.65rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.glass-btn,
		.glass-btn .arrow,
		.af-point,
		.readout .af {
			transition: none;
		}
	}
</style>
