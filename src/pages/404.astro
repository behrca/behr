---
// Shown when someone visits an address that doesn't exist on the site.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="This page doesn't exist." />
	</head>
	<body>
		<Header />
		<main class="not-found">
			<p class="eyebrow">404</p>
			<h1>This page doesn’t exist.</h1>
			<p class="text">The link may be old or mistyped. The photos are all in the gallery.</p>
			<a class="button" href="/gallery">
				<span class="label">Open the gallery</span>
				<span class="arrow" aria-hidden="true">→</span>
			</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.not-found {
		width: 100%;
		max-width: 100%;
		min-height: 80vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 10rem 6vw 6rem;
		text-align: center;
		background: var(--site-bg);
		color: var(--site-fg);
	}
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--site-fg-3);
	}
	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.2rem, 6vw, 4rem);
		line-height: 1.05;
		color: var(--site-fg);
	}
	.text {
		max-width: 30rem;
		margin: 0 0 2.5rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--site-fg-2);
	}
	.button {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		border: 2px solid var(--site-fg);
		color: var(--site-fg);
		padding: 0.9rem 1.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-size: 0.8rem;
		text-decoration: none;
		transition: color 0.4s ease;
	}
	.button::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--site-fg);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
		z-index: -1;
	}
	.button .arrow {
		display: inline-block;
		transition: transform 0.35s ease;
	}
	.button:hover,
	.button:focus-visible {
		color: var(--site-bg);
	}
	.button:hover::before,
	.button:focus-visible::before {
		transform: scaleX(1);
	}
	.button:hover .arrow,
	.button:focus-visible .arrow {
		transform: translateX(5px);
	}
	@media (prefers-reduced-motion: reduce) {
		.button,
		.button::before,
		.button .arrow {
			transition: none;
		}
	}
</style>
